# Runtime files. Keep empty directories so non-root containers can mount them.
instance/*
!instance/.gitkeep

# Local backups and bundles
backups/*
!backups/.gitkeep
*.zip

# Environment and secrets
.env
.env.*
!.env.example

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.venv/
.coverage
.coverage.*
htmlcov/

# Editors/OS
.vscode/
.idea/
.DS_Store

# Logs and runtime output
logs/*
!logs/.gitkeep
*.log
